# --- AI bridge (server-side, never bundled into client) ---
# Required for the "Generate Form" button to work.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default Gemini model.
# Default: gemini-2.5-flash (free tier, supports function calling)
# Other free-tier options: gemini-2.0-flash, gemini-1.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# --- Firebase Admin (server-side, used by the AI bridge for auth + quota) ---
# Get these from Firebase Console → Project Settings → Service accounts → "Generate new private key".
# The downloaded JSON contains all three fields. Server-only — DO NOT prefix with VITE_.
FIREBASE_PROJECT_ID=ai-form-builder-113fe
FIREBASE_CLIENT_EMAIL=
# IMPORTANT: in dashboards (Vercel, etc) paste the private key with literal "\n" sequences.
# The runtime restores them to real newlines.
FIREBASE_PRIVATE_KEY=

# --- Client-side (Vite-exposed, must be prefixed with VITE_) ---
# Optional: override the AI generate endpoint (e.g. when pointing at a deployed Cloud Function).
# Default: /api/generate-form (handled by the dev-server middleware in dev, by api/generate-form.ts on Vercel in prod)
# VITE_AI_GENERATE_URL=https://your-region-your-project.cloudfunctions.net/generateForm
